# === Dashboard ===
# Nom d'utilisateur pour se connecter au dashboard
ADMIN_USER=admin
# Mot de passe du dashboard. Si laissé vide, un mot de passe aléatoire est
# généré au premier démarrage et écrit dans data/initial-password.txt
ADMIN_PASSWORD=change-me-please

# Port du dashboard web (à l'interieur du conteneur)
DASHBOARD_PORT=3000

# Secret de signature des cookies de session. Laisser vide pour générer
# automatiquement (stocké dans data/session.secret)
SESSION_SECRET=

# === WireGuard ===
# IP publique ou domaine du serveur. Laisser vide = auto-détection
PUBLIC_IP=

# Sous-réseau VPN
WG_SUBNET=10.13.13.0/24
WG_SERVER_IP=10.13.13.1
WG_PORT=51820

# DNS poussés aux clients
WG_DNS=1.1.1.1,1.0.0.1
